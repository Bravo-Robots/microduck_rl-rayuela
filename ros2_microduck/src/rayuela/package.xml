<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rayuela</name>
  <version>0.0.0</version>
  <description>Microduck rayuela (hopscotch) game: MuJoCo sim + ONNX policies, ball vision and go-to-casilla control</description>
  <maintainer email="robot@todo.todo">robot</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>rayuela_msgs</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <!-- numpy, opencv, mujoco, onnxruntime and bam come from the project venv
       (uv sync), not from apt: apt's python3-opencv is built against NumPy 1
       and cannot load next to the venv's NumPy 2. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
